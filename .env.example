# Copiar como .env.local para desarrollo, o cargar en Vercel → Settings → Environment Variables.
# Todo es opcional: sin variables, la app funciona en modo demo.

# --- Acceso ---
# Contraseña para entrar a la app (muy recomendado al publicarla).
APP_PASSWORD=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# BUSINESS_NAME=Fernanda Donoso Gestión Inmobiliaria
# AGENT_NAME=Fernanda

# --- Base de datos (Supabase) ---
# Sin estas dos variables los datos viven en memoria y se reinician.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta (webhook común) ---
# Texto inventado por ti; el mismo se pone en la configuración del webhook en Meta.
META_VERIFY_TOKEN=
# App secret de la app de Meta (valida que los mensajes vengan de Meta).
META_APP_SECRET=
# META_GRAPH_VERSION=v23.0

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Messenger e Instagram (token de la página de Facebook vinculada) ---
META_PAGE_ACCESS_TOKEN=

# --- Correos de reservas (Resend: https://resend.com) ---
# Sin RESEND_API_KEY no se envían correos y el botón "Solicitar por correo" no aparece.
RESEND_API_KEY=
# Remitente. Hasta verificar el dominio en Resend, usar onboarding@resend.dev
# (solo entrega al correo dueño de la cuenta de Resend).
MAIL_FROM=Fernanda Donoso <reservas@fernandadonoso.cl>
# Correo de Fernanda: recibe los avisos de solicitudes y las copias de las confirmaciones.
NOTIFY_EMAIL=
# Datos de transferencia que se envían al huésped (texto libre, varias líneas).
TRANSFER_INFO=
# Dirección pública del sitio (para el enlace al CRM en los correos).
SITE_URL=https://www.fernandadonoso.cl
# Clave para la tarea diaria de recordatorios (Vercel la envía sola).
CRON_SECRET=
